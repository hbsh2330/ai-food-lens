# Copy this file to .env and enter your local PostgreSQL connection string.
# Never commit the real .env file.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/foodlens
# Google Android sign-in backend verification (web application client ID; not a secret).
GOOGLE_WEB_CLIENT_ID=908444813761-usju1vdrhk4oh05tpvra6pjs2ccb5ac2.apps.googleusercontent.com
# Generate a long random value for each environment. Never commit the real .env.
APP_JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET

# Kakao Native App Key is configured in Flutter android/local.properties, not here.
# KAKAO_NATIVE_APP_KEY=YOUR_KAKAO_NATIVE_APP_KEY